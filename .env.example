# ==============================================================================
# CMRG Survey — Environment Configuration Template (.env.example)
#
# 🤖 INSTRUCTIONS FOR VS CODE GITHUB COPILOT / DEVOPS ENGINEER:
# All secret keys were deliberately skipped in the Google AI Studio sandbox.
# When working in VS Code, prompt Copilot:
# "Generate production cryptographic secrets for .env using scripts/generate-production-keys.sh"
# or fill in strong values for each parameter below.
# ==============================================================================

NODE_ENV=production
PORT=3000

# 1. Express / JWT Authentication Session Secret (64-char random hex)
AUTH_SECRET=

# 2. PostgreSQL 16 Production Database Connection String
DATABASE_URL=postgresql://cmrg_admin:YOUR_POSTGRES_PASSWORD@localhost:5432/cmrg_survey

# 3. CMRG Collect Field Mobile Synchronization Secret
CMRG_COLLECT_SYNC_SECRET=

# 4. Media & Attachment Storage AES-256 Key
STORAGE_SECRET_KEY=
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads/media

# 5. Central Administrator Initial Provisioning Password
ADMIN_INITIAL_PASSWORD=

# 6. Django 5.0 Backend Secrets (When running django_backend container)
DJANGO_SECRET_KEY=
POSTGRES_DB=cmrg_survey
POSTGRES_USER=cmrg_admin
POSTGRES_PASSWORD=
SIMPLE_JWT_SIGNING_KEY=
CMRG_MOBILE_SYNC_KEY=

# 7. Optional Server-Side Gemini AI Assistant Key
GEMINI_API_KEY=
